/* Dark theme accents QPalette can't express.
   Templated with Python's string.Template (dollar-sign placeholders, e.g.
   dollar-bg) - see ui/theme/tokens.py and ui/theme/theme_manager.py's
   _load_qss(). Only tokens that map cleanly onto an existing brand color
   are parameterized; the handful of hover/pressed micro-shades below
   (#202942, #26305a, #161d33, #232c46, #c7cde3, #37416a) are neutral UI
   chrome, not brand identity, and stay hardcoded per mode - a plugin-
   contributed palette re-themes backgrounds/text/accent, not every
   hand-tuned hover state. */

QMainWindow, QDialog {
    background-color: $bg;
}

QListView {
    border: none;
    background-color: transparent;
    outline: 0;
}

QListView::item {
    border-radius: 10px;
    padding: 4px;
}

QListView::item:hover {
    background-color: #202942;
}

QListView::item:selected {
    background-color: #26305a;
}

/* -- Sidebar ---------------------------------------------------------- */

#SidebarPanel {
    background-color: #161d33;
    border-right: 1px solid $border;
}

#BrandHeader {
    background-color: transparent;
    border-bottom: 1px solid $border;
}

#BrandTitle {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.2px;
    color: $text;
}

#CategorySidebar {
    background-color: transparent;
    border: none;
    padding: 6px;
}

/* Matches _CategorySidebarDelegate's "Categories" header row as closely as
   QSS can: same left inset (CategorySidebar's own 6px padding + the
   delegate's 14px text inset = 20px), same muted/bold/small treatment. */
#SidebarSectionLabel {
    padding: 12px 8px 6px 20px;
    font-size: 10px;
    font-weight: 700;
    color: $subtext;
}

#SidebarFooter {
    background-color: transparent;
    border-top: 1px solid $border;
}

QPushButton#SidebarAddProjectButton {
    border: 1px dashed #3a4260;
    border-radius: 9px;
    padding: 8px 10px;
    background-color: transparent;
    color: $subtext;
    font-weight: 600;
}

QPushButton#SidebarAddProjectButton:hover {
    border-color: $accent_blend_hover;
    color: $accent_blend_hover;
    background-color: #232c46;
}

#CategorySidebar::item {
    border-radius: 9px;
    padding: 7px 10px;
    margin: 2px 0;
    color: #c7cde3;
}

#CategorySidebar::item:hover {
    background-color: #232c46;
}

#CategorySidebar::item:selected {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 $accent_blue, stop:1 $accent_purple);
    color: white;
    font-weight: 600;
}

/* -- Toolbar (search + view toggle + sort + add project) --------------- */

#Toolbar {
    background-color: $surface;
    border-bottom: 1px solid $border;
}

QLineEdit#SearchBar {
    border: 1px solid $border;
    border-radius: 9px;
    padding: 7px 12px;
    background-color: $surface_alt;
    color: $text;
    selection-background-color: $accent_blend;
}

QLineEdit#SearchBar:focus {
    border: 1px solid $accent_blend_hover;
    background-color: $surface;
}

#ViewToggle {
    background-color: $surface_alt;
    border: 1px solid $border;
    border-radius: 9px;
}

#ViewToggle QToolButton {
    border: none;
    border-radius: 7px;
    padding: 7px 10px;
    background-color: transparent;
    color: $subtext;
    font-weight: 600;
}

#ViewToggle QToolButton:checked {
    background-color: #2a3350;
    color: #ffffff;
}

#ViewToggle QToolButton:hover:!checked {
    color: $text;
}

QToolButton#SortButton {
    border: 1px solid $border;
    border-radius: 9px;
    padding: 6px 10px;
    background-color: $surface;
    color: $text;
}

QToolButton#SortButton::menu-indicator {
    image: none;
    width: 0;
}

QToolButton#SortButton:hover {
    background-color: #232c46;
    border-color: #37416a;
}

QPushButton#PrimaryButton {
    border: none;
    border-radius: 9px;
    padding: 8px 18px;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 $accent_blue, stop:1 $accent_purple);
    color: white;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 $accent_blend_hover, stop:1 $accent_purple);
}

QPushButton#PrimaryButton:pressed {
    background-color: $accent_blend;
}

/* -- Buttons -------------------------------------------------------- */

QPushButton {
    border: 1px solid $border;
    border-radius: 7px;
    padding: 6px 14px;
    background-color: $surface;
    color: $text;
}

QPushButton:hover {
    background-color: #232c46;
    border-color: #37416a;
}

QPushButton:pressed {
    background-color: #26305a;
}

QPushButton:default {
    background-color: $accent_blend;
    border-color: $accent_blend;
    color: white;
    font-weight: 600;
}

QPushButton:default:hover {
    background-color: $accent_blend_hover;
}

QToolBar {
    border: none;
    spacing: 6px;
}

QMenu {
    border: 1px solid $border;
    border-radius: 8px;
    padding: 4px;
    background-color: $surface;
    color: $text;
}

QMenu::item {
    border-radius: 6px;
    padding: 6px 20px;
}

QMenu::item:selected {
    background-color: #26305a;
    color: #ffffff;
}

QStatusBar {
    background-color: #161d33;
    border-top: 1px solid $border;
    color: #c7cde3;
}

QSplitter::handle {
    background-color: $border;
    width: 1px;
}

/* -- Plugin Manager ---------------------------------------------------- */

#PluginList {
    background-color: transparent;
    border: none;
}

#PluginList::item {
    background-color: transparent;
    border: none;
    padding: 0;
}

QFrame#PluginCard {
    background-color: $surface_alt;
    border: 1px solid $border;
    border-radius: 10px;
}

QFrame#PluginCard:hover {
    border-color: $accent_blend;
}

QFrame#PluginCard[selected="true"] {
    border: 2px solid $accent_blend;
}

QPushButton#PluginUpdateButton {
    background-color: $accent_blend;
    border-color: $accent_blend;
    color: white;
    font-weight: 600;
}

QPushButton#PluginUpdateButton:hover {
    background-color: $accent_blend_hover;
}

/* -- Form dialogs (Add Project, prompt_text()...) ----------------------- */

QLabel#FieldLabel {
    color: $subtext;
    font-weight: 600;
    font-size: 12px;
}

QPushButton#CategoryChipToggle {
    border: 1px solid $border;
    border-radius: 14px;
    padding: 6px 14px;
    background-color: $surface_alt;
    color: $subtext;
    font-weight: 600;
}

QPushButton#CategoryChipToggle:hover {
    border-color: $accent_blend_hover;
    color: $text;
}

QPushButton#CategoryChipToggle:checked {
    background-color: rgba(93, 123, 255, 0.18);
    border-color: $accent_blend_hover;
    color: #ffffff;
}
