<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Reference Info.plist for the macOS .app bundle. PyInstaller's `BUNDLE()`
  step (see packaging/pyinstaller/myapps.spec) generates its own Info.plist
  from the `info_plist` dict there; this file documents the intended values
  and is useful if the bundle is ever assembled by hand or with another tool.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MyAppsLibrary</string>
    <key>CFBundleDisplayName</key>
    <string>MyAppsLibrary</string>
    <key>CFBundleIdentifier</key>
    <string>com.myappslibrary.app</string>
    <key>CFBundleVersion</key>
    <string>0.5.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.5.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>MyAppsLibrary</string>
    <key>CFBundleIconFile</key>
    <string>app.icns</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>MIT License</string>
</dict>
</plist>
